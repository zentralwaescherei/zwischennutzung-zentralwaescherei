{
  "collectionName": "components_content_text_blocks",
  "info": {
    "displayName": "Text Block",
    "description": "Reusable text content for placements across the site"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "heading": {
      "type": "string"
    },
    "bodyRichText": {
      "type": "richtext",
      "required": true
    },
    "ctaLabel": {
      "type": "string"
    },
    "ctaUrl": {
      "type": "string",
      "regex": "^(https?:\\/\\/|\\/).+"
    },
    "styleVariant": {
      "type": "enumeration",
      "enum": [
        "default",
        "accent",
        "muted"
      ],
      "default": "default"
    },
    "placementKey": {
      "type": "string",
      "required": true
    }
  }
}
